# Copie para .env.local (ignorado pelo Git) para uma configuração persistente no computador.
# Sem configuração, o app usa a Agenda API publicada abaixo.
# A presença dessa URL não garante que a versão implantada tenha autenticação.
# EXPO_PUBLIC_API_URL=https://vox-backend-latest.onrender.com

# Use somente a raiz da API, sem /auth/login ou /api/vox/transcriptions.
# Para testar um backend local, descomente apenas UMA destas opções:
# Navegador no mesmo computador / simulador iOS:
# EXPO_PUBLIC_API_URL=http://localhost:8080
# Emulador Android:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
# Celular físico: use o IPv4 do computador na mesma rede Wi-Fi:
# EXPO_PUBLIC_API_URL=http://192.168.0.10:8080

# 10.0.2.2 é exclusivo do emulador Android e é recusado na web.
# Após mudar .env.local, reinicie o Expo com: npx expo start --clear

# Login com Google (IDs públicos do Google Cloud Console; nunca coloque client secret aqui).
# Web Client ID: obrigatório. É o "ID do cliente" do tipo Aplicativo da Web.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=SEU_WEB_CLIENT_ID.apps.googleusercontent.com
# iOS Client ID: opcional, só necessário se o app for publicado no iOS.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=SEU_IOS_CLIENT_ID.apps.googleusercontent.com
