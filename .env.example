# Destino padrão já configurado no código: Agenda API publicada do Synapse (rotas legadas do backend).
# Descomente a linha abaixo somente para sobrescrever o endereço padrão.
# EXPO_PUBLIC_API_URL=https://vox-backend-latest.onrender.com

# Para testar um backend local, use apenas UMA destas opções:
# Navegador no mesmo computador / simulador iOS:
# EXPO_PUBLIC_API_URL=http://localhost:8080
# Emulador Android:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
# Celular físico: use o IPv4 do computador na mesma rede Wi-Fi:
# EXPO_PUBLIC_API_URL=http://192.168.0.10:8080

# Após mudar .env, reinicie o Expo com: npx expo start -c
