# Configure apenas uma URL, de acordo com o ambiente em que o app será executado.
# Navegador no mesmo computador ou simulador iOS:
# EXPO_PUBLIC_API_URL=http://localhost:8080

# Emulador Android do Android Studio:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Celular Android físico: use o IPv4 do computador (descubra com ipconfig).
# EXPO_PUBLIC_API_URL=http://192.168.0.10:8080

# Após alterar este arquivo, reinicie o Expo com: npx expo start -c
